# Environment
NODE_ENV=development

# Server
PORT=3000

# Database (Docker Compose PostgreSQL)
DATABASE_URL=postgresql://shelter_user:shelter_password@localhost:5433/shelter

# Google OAuth (placeholder - update with real values)
GOOGLE_CLIENT_ID=placeholder-client-id
GOOGLE_CLIENT_SECRET=placeholder-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Session
SESSION_COOKIE_NAME=shelter_session
SESSION_SECRET=dev-secret-key-change-in-production
SESSION_TTL_HOURS=168

# Frontend URL
FRONTEND_URL=http://localhost:3001
