// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique @db.Citext
  fullName       String?
  passwordHash   String?
  isTest         Boolean    @default(false)
  status         UserStatus @default(ACTIVE)
  role           UserRole   @default(STAFF)
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  sessions       Session[]
  ownedLocations Location[] @relation("ownedLocations")
  createdCats    Cat[]      @relation("createdCats")
  createdPhotos  CatPhoto[] @relation("createdPhotos")
  deletedPhotos  CatPhoto[] @relation("deletedPhotos")
  catAuditEvents CatAuditEvent[] @relation("catAuditActors")
  tagAuditEvents TagAuditEvent[] @relation("tagAuditActors")
  locationAuditEvents LocationAuditEvent[] @relation("locationAuditActors")

  @@index([status])
  @@index([role])
  @@index([email])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  ADMIN
  STAFF
}

enum LocationStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CatSex {
  FEMALE
  MALE
  UNKNOWN
}

enum SterilizationStatus {
  STERILIZED
  NOT_STERILIZED
  UNKNOWN
}

enum CatAuditEventType {
  cat_created
  cat_archived
  cat_dearchived
  archivation_reason_create
  archivation_reason_update
  archivation_reason_delete
  name_changed
  sex_changed
  color_changed
  estimated_birth_date_changed
  intake_date_changed
  rescue_source_changed
  microchip_number_changed
  passport_number_changed
  sterilization_status_changed
  status_changed
  current_location_changed
photo_created
  photo_deleted
  weight_created
  weight_deleted
  tag_added_to_cat
  tag_removed_from_cat
}

model Location {
  id          String         @id @default(cuid())
  name        String
  description String?
  ownerId     String?
  owner       User?          @relation("ownedLocations", fields: [ownerId], references: [id], onDelete: SetNull)
  isTest      Boolean        @default(false)
  status      LocationStatus @default(ACTIVE)
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  cats        Cat[]
  auditEvents LocationAuditEvent[]

  @@index([ownerId])
  @@index([isTest])
  @@index([status])
  @@index([deletedAt])
}

model LocationAuditEvent {
  id          String   @id @default(cuid())
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  actorUserId String
  actorUser   User     @relation("locationAuditActors", fields: [actorUserId], references: [id], onDelete: Restrict)
  action      String
  oldValue    String?
  newValue    String?
  createdAt   DateTime @default(now())

  @@index([locationId])
  @@index([actorUserId])
  @@index([createdAt])
}

model Cat {
  id                  String              @id @default(cuid())
  name                String
  sex                 CatSex              @default(UNKNOWN)
  color               String?
  estimatedBirthDate  DateTime?
  intakeDate          DateTime?
  rescueSource        String?
  microchipNumber     String?             @unique
  passportNumber      String?             @unique
  sterilizationStatus SterilizationStatus @default(UNKNOWN)
  archivedAt          DateTime?
  archivationReasonId String?
  archivationReason   CatArchivationReason? @relation(fields: [archivationReasonId], references: [id], onDelete: Restrict)
  isTest              Boolean             @default(false)
  currentLocationId   String?
  currentLocation     Location?           @relation(fields: [currentLocationId], references: [id], onDelete: SetNull)
  createdByUserId     String?
  createdByUser       User?               @relation("createdCats", fields: [createdByUserId], references: [id], onDelete: SetNull)
  primaryPhotoKey     String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  weights             CatWeight[]
  tags                CatTagOnCat[]
  photos              CatPhoto[]
  auditEvents         CatAuditEvent[]

  @@index([createdByUserId])
  @@index([currentLocationId])
  @@index([isTest])
  @@index([archivedAt])
  @@index([archivationReasonId])
  @@index([name])
  @@index([intakeDate])
}

model CatArchivationReason {
  id          String   @id @default(cuid())
  name        String
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cats        Cat[]
  auditEvents CatAuditEvent[]

  @@index([deletedAt])
}

model CatPhoto {
  id              String   @id @default(cuid())
  catId           String
  cat             Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  key             String   @unique
  createdByUserId String?
  createdByUser   User?    @relation("createdPhotos", fields: [createdByUserId], references: [id], onDelete: SetNull)
  deletedByUserId String?
  deletedByUser   User?    @relation("deletedPhotos", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  auditEvents     CatAuditEvent[]

  @@index([catId])
  @@index([createdByUserId])
  @@index([deletedByUserId])
  @@index([deletedAt])
  @@index([createdAt])
}

model CatAuditEvent {
  id          String            @id @default(cuid())
  catId       String?
  cat         Cat?              @relation(fields: [catId], references: [id], onDelete: Cascade)
  archivationReasonId String?
  archivationReason CatArchivationReason? @relation(fields: [archivationReasonId], references: [id], onDelete: SetNull)
  actorUserId String
  actorUser   User              @relation("catAuditActors", fields: [actorUserId], references: [id], onDelete: Restrict)
  eventType   CatAuditEventType
  occurredAt  DateTime          @default(now())
  oldValue    String?
  newValue    String?
  photoId     String?
  photo       CatPhoto?         @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@index([catId, occurredAt])
  @@index([archivationReasonId, occurredAt])
  @@index([actorUserId])
  @@index([photoId])
  @@index([eventType])
}

model CatTag {
  id        String        @id @default(cuid())
  name      String
  color     String        @default("#ffb38a")
  deletedAt DateTime?
  createdAt DateTime      @default(now())
  cats      CatTagOnCat[]
  auditEvents TagAuditEvent[]

  @@index([name])
  @@index([deletedAt])
}

model TagAuditEvent {
  id          String   @id @default(cuid())
  tagId       String?
  tag         CatTag?  @relation(fields: [tagId], references: [id], onDelete: SetNull)
  actorUserId String
  actorUser   User     @relation("tagAuditActors", fields: [actorUserId], references: [id], onDelete: Restrict)
  action      String
  oldValue    String?
  newValue    String?
  createdAt   DateTime @default(now())

  @@index([tagId])
  @@index([actorUserId])
  @@index([createdAt])
}

model CatTagOnCat {
  catId String
  tagId String
  cat   Cat    @relation(fields: [catId], references: [id], onDelete: Cascade)
  tag   CatTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([catId, tagId])
  @@index([tagId])
}

model CatWeight {
  id         String   @id @default(cuid())
  catId      String
  cat        Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  weightKg   Float
  measuredAt DateTime
  createdAt  DateTime @default(now())

  @@index([catId])
  @@index([measuredAt])
}

