// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique @db.Citext
  fullName       String?
  passwordHash   String?
  status         UserStatus @default(ACTIVE)
  role           UserRole   @default(STAFF)
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  sessions       Session[]
  ownedLocations Location[] @relation("ownedLocations")

  @@index([status])
  @@index([role])
  @@index([email])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  ADMIN
  STAFF
}

enum LocationStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CatSex {
  FEMALE
  MALE
  UNKNOWN
}

enum SterilizationStatus {
  STERILIZED
  NOT_STERILIZED
  UNKNOWN
}

enum CatStatus {
  ACTIVE
  ADOPTED
  DECEASED
  ARCHIVED
}

model Location {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  ownerId     String?
  owner       User?          @relation("ownedLocations", fields: [ownerId], references: [id], onDelete: SetNull)
  status      LocationStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  cats        Cat[]

  @@index([ownerId])
  @@index([status])
}

model Cat {
  id                  String              @id @default(cuid())
  name                String
  sex                 CatSex              @default(UNKNOWN)
  color               String?
  estimatedBirthDate  DateTime?
  intakeDate          DateTime?
  rescueSource        String?
  microchipNumber     String?             @unique
  passportNumber      String?             @unique
  sterilizationStatus SterilizationStatus @default(UNKNOWN)
  status              CatStatus           @default(ACTIVE)
  currentLocationId   String?
  currentLocation     Location?           @relation(fields: [currentLocationId], references: [id], onDelete: SetNull)
  primaryPhotoKey     String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  weights             CatWeight[]
  tags                CatTagOnCat[]

  @@index([currentLocationId])
  @@index([status])
  @@index([name])
  @@index([intakeDate])
}

model CatTag {
  id        String        @id @default(cuid())
  name      String        @unique
  color     String        @default("#ffb38a")
  createdAt DateTime      @default(now())
  cats      CatTagOnCat[]

  @@index([name])
}

model CatTagOnCat {
  catId String
  tagId String
  cat   Cat    @relation(fields: [catId], references: [id], onDelete: Cascade)
  tag   CatTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([catId, tagId])
  @@index([tagId])
}

model CatWeight {
  id         String   @id @default(cuid())
  catId      String
  cat        Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  weightKg   Float
  measuredAt DateTime
  createdAt  DateTime @default(now())

  @@index([catId])
  @@index([measuredAt])
}
