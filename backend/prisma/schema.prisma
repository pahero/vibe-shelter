// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  extensions = [citext]
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique @db.Citext
  fullName       String?
  passwordHash   String?
  passwordChangeRequired Boolean @default(false)
  isTest         Boolean    @default(false)
  status         UserStatus @default(ACTIVE)
  role           UserRole   @default(STAFF)
  lastLoginAt    DateTime?
  deletedAt      DateTime?
  version        Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  ownedLocations Location[] @relation("ownedLocations")
  createdCats    Cat[]      @relation("createdCats")
  createdPhotos  CatPhoto[] @relation("createdPhotos")
  deletedPhotos  CatPhoto[] @relation("deletedPhotos")
  createdDocuments CatDocument[] @relation("createdDocuments")
  deletedDocuments CatDocument[] @relation("deletedDocuments")
  auditEvents AuditEvent[] @relation("auditActors")
  relatedAuditEvents AuditEvent[] @relation("auditRelatedUsers")
  taskReceivers      CatTaskReceiver[]    @relation("taskReceivers")
  completedTasks     CatTask[]            @relation("completedTasks")
  taskNotifications  TaskNotification[]
  checkedTreatmentAdministrations CatTreatmentAdministration[] @relation("treatmentAdministrationCheckers")
  createdNotes CatNote[] @relation("createdNotes")
  createdMedicalNotes CatMedicalNote[] @relation("createdMedicalNotes")
  createdVaccinations Vaccination[] @relation("createdVaccinations")
  updatedVaccinations Vaccination[] @relation("updatedVaccinations")
  createdParasiteTreatments ParasiteTreatment[] @relation("createdParasiteTreatments")
  updatedParasiteTreatments ParasiteTreatment[] @relation("updatedParasiteTreatments")
  createdCatTreatments CatTreatment[] @relation("createdCatTreatments")
  updatedCatTreatments CatTreatment[] @relation("updatedCatTreatments")
  refreshTokens RefreshToken[]
  pushSubscriptions PushSubscription[]
  favoriteCats CatFavorite[]

  @@index([status])
  @@index([role])
  @@index([email])
  @@index([deletedAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

enum LocationStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CatIntakeSource {
  SHELTER_VOLUNTEER
  OWNER_SURRENDER
  RESCUE_REQUEST
  VET_CLINIC
  RESCUE_ORGANISATION
  OTHER
}

enum CatSex {
  FEMALE
  MALE
  UNKNOWN
}

enum SterilizationStatus {
  STERILIZED
  NOT_STERILIZED
  UNKNOWN
}

enum VaccinationType {
  RABIES
  CORE
  OTHER
}

enum ParasiteTreatmentType {
  FLEAS_TICKS
  DEWORMING
  COMBINED
  OTHER
}

model Location {
  id          String         @id @default(cuid())
  name        String
  description String?
  ownerId     String?
  owner       User?          @relation("ownedLocations", fields: [ownerId], references: [id], onDelete: SetNull)
  isTest      Boolean        @default(false)
  status      LocationStatus @default(ACTIVE)
  deletedAt   DateTime?
  version     Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  cats        Cat[]
  auditEvents AuditEvent[]

  @@index([ownerId])
  @@index([isTest])
  @@index([status])
  @@index([deletedAt])
}


model Cat {
  id                  String              @id @default(cuid())
  name                String
  nameNumber          Int                 @default(1)
  sex                 CatSex              @default(UNKNOWN)
  color               String?
  estimatedBirthDate  DateTime?
  intakeDate          DateTime?
  intakeDetails        String?
  intakeSource         CatIntakeSource?
  microchipNumber     String?             @unique
  passport            Boolean             @default(false)
  sponsorName         String?
  adopterName         String?
  adopterAddress      String?
  felvFivTestDone     Boolean             @default(false)
  isFlightCandidate   Boolean             @default(false)
  sterilizationStatus SterilizationStatus @default(UNKNOWN)
  archivedAt          DateTime?
  deletedAt           DateTime?
  version             Int                 @default(0)
  concurrencyToken    String              @default(cuid())
  archivingReasonId String?
  archivingReason   CatArchivingReason? @relation(fields: [archivingReasonId], references: [id], onDelete: Restrict)
  isTest              Boolean             @default(false)
  currentLocationId   String?
  currentLocation     Location?           @relation(fields: [currentLocationId], references: [id], onDelete: SetNull)
  createdByUserId     String?
  createdByUser       User?               @relation("createdCats", fields: [createdByUserId], references: [id], onDelete: SetNull)
  primaryPhotoKey     String?
  primaryPhotoPositionY Float?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  weights             CatWeight[]
  tags                CatTagOnCat[]
  photos              CatPhoto[]
  documents           CatDocument[]
  auditEvents         AuditEvent[] @relation("auditCats")
  tasks               CatTask[]
  treatments          CatTreatment[]
  medicalNotes        CatMedicalNote[]
  vaccinations        Vaccination[]
  parasiteTreatments  ParasiteTreatment[]
  notes               CatNote[]
  flightAssignments  FlightCatAssignment[]
  favorites CatFavorite[]


  @@index([createdByUserId])
  @@index([currentLocationId])
  @@index([isTest])
  @@index([archivedAt])
  @@index([deletedAt])
  @@index([archivingReasonId])
  @@index([name])
  @@unique([name, nameNumber, isTest])
  @@index([intakeDate])
}

model CatFavorite {
  userId String
  catId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  cat Cat @relation(fields: [catId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, catId])
  @@index([catId])
}

model CatArchivingReason {
  id          String   @id @default(cuid())
  name        String
  isTest      Boolean  @default(false)
  deletedAt   DateTime?
  version     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cats        Cat[]
  auditEvents AuditEvent[] @relation("auditArchivingReasons")

  @@index([deletedAt])
  @@index([isTest])
}

model CatPhoto {
  id              String   @id @default(cuid())
  catId           String
  cat             Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  key             String   @unique
  previewKey      String?
  createdByUserId String?
  createdByUser   User?    @relation("createdPhotos", fields: [createdByUserId], references: [id], onDelete: SetNull)
  deletedByUserId String?
  deletedByUser   User?    @relation("deletedPhotos", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  deletedAt       DateTime?
  version         Int      @default(0)
  createdAt       DateTime @default(now())
  auditEvents     AuditEvent[]

  @@index([catId])
  @@index([createdByUserId])
  @@index([deletedByUserId])
  @@index([deletedAt])
  @@index([createdAt])
}

model CatDocument {
  id              String   @id @default(cuid())
  catId           String
  cat             Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  key             String   @unique
  fileName        String
  createdByUserId String?
  createdByUser   User?    @relation("createdDocuments", fields: [createdByUserId], references: [id], onDelete: SetNull)
  deletedByUserId String?
  deletedByUser   User?    @relation("deletedDocuments", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  deletedAt       DateTime?
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  auditEvents     AuditEvent[]

  @@index([catId])
  @@index([createdByUserId])
  @@index([deletedByUserId])
  @@index([deletedAt])
  @@index([createdAt])
}


model CatTag {
  id        String        @id @default(cuid())
  name      String
  color     String        @default("#ffb38a")
  isTest    Boolean       @default(false)
  deletedAt DateTime?
  version   Int           @default(0)
  createdAt DateTime      @default(now())
  cats      CatTagOnCat[]
  auditEvents AuditEvent[] @relation("auditTags")

  @@index([name])
  @@index([isTest])
  @@index([deletedAt])
}


model CatTagOnCat {
  catId     String
  tagId     String
  cat       Cat       @relation(fields: [catId], references: [id], onDelete: Cascade)
  tag       CatTag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  deletedAt DateTime?
  version   Int       @default(0)

  @@id([catId, tagId])
  @@index([tagId])
  @@index([deletedAt])
}

model CatWeight {
  id         String   @id @default(cuid())
  catId      String
  cat        Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  weightKg   Float
  measuredAt DateTime
  deletedAt  DateTime?
  version    Int      @default(0)
  createdAt  DateTime @default(now())
  auditEvents AuditEvent[] @relation("auditWeights")

  @@index([catId])
  @@index([measuredAt])
  @@index([deletedAt])
}

model CatTreatment {
  id          String   @id @default(cuid())
  catId       String
  cat         Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdByUser User? @relation("createdCatTreatments", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId String?
  updatedByUser User? @relation("updatedCatTreatments", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  shortName   String
  instructions String?
  startDate   DateTime @db.Date
  endDate     DateTime? @db.Date
  dosesPerDay Int
  notificationSent Boolean @default(false)
  deletedAt   DateTime?
  concurrencyToken String @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  administrations CatTreatmentAdministration[]
  notifications   TaskNotification[]
  auditEvents     AuditEvent[]

  @@index([catId, createdAt])
  @@index([catId, startDate, endDate])
  @@index([deletedAt])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([notificationSent, startDate])
}

model CatTreatmentAdministration {
  treatmentId     String
  treatment       CatTreatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  administeredOn  DateTime @db.Date
  doseNumber      Int
  checkedByUserId String
  checkedByUser   User @relation("treatmentAdministrationCheckers", fields: [checkedByUserId], references: [id], onDelete: Restrict)
  deletedAt       DateTime?
  version         Int      @default(0)
  createdAt       DateTime @default(now())

  @@id([treatmentId, administeredOn, doseNumber])
  @@index([checkedByUserId])
  @@index([treatmentId, administeredOn])
  @@index([deletedAt])
}

model Flight {
  id                String   @id @default(cuid())
  date              DateTime @db.Date
  airport           String
  flightNumber      String
  flightParent      String
  isTest            Boolean  @default(false)
  deletedAt         DateTime?
  concurrencyToken  String   @default(cuid())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  assignments       FlightCatAssignment[]
  auditEvents       AuditEvent[] @relation("auditFlights")

  @@index([date])
  @@index([deletedAt])
  @@index([isTest])
}

model FlightCatAssignment {
  id               String   @id @default(cuid())
  flightId         String
  flight           Flight   @relation(fields: [flightId], references: [id], onDelete: Restrict)
  catId            String
  cat              Cat      @relation(fields: [catId], references: [id], onDelete: Restrict)
  f2fDone          Boolean  @default(false)
  tracesDone       Boolean  @default(false)
  deletedAt        DateTime?
  concurrencyToken String   @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  auditEvents      AuditEvent[] @relation("auditAssignments")

  @@index([flightId, deletedAt])
  @@index([catId, deletedAt])
  @@index([concurrencyToken])
}


model AuditEvent {
  id String @id @default(cuid())
  catId String?
  cat Cat? @relation("auditCats", fields: [catId], references: [id], onDelete: Cascade)
  flightId String?
  flight Flight? @relation("auditFlights", fields: [flightId], references: [id], onDelete: SetNull)
  assignmentId String?
  assignment FlightCatAssignment? @relation("auditAssignments", fields: [assignmentId], references: [id], onDelete: SetNull)
  locationId String?
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  tagId String?
  tag CatTag? @relation("auditTags", fields: [tagId], references: [id], onDelete: SetNull)
  archivingReasonId String?
  archivingReason CatArchivingReason? @relation("auditArchivingReasons", fields: [archivingReasonId], references: [id], onDelete: SetNull)
  treatmentId String?
  treatment CatTreatment? @relation(fields: [treatmentId], references: [id], onDelete: SetNull)
  photoId String?
  photo CatPhoto? @relation(fields: [photoId], references: [id], onDelete: SetNull)
  documentId String?
  document CatDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  weightId String?
  weight CatWeight? @relation("auditWeights", fields: [weightId], references: [id], onDelete: SetNull)
  taskId String?
  task CatTask? @relation("auditTasks", fields: [taskId], references: [id], onDelete: SetNull)
  medicalNoteId String?
  medicalNote CatMedicalNote? @relation("auditMedicalNotes", fields: [medicalNoteId], references: [id], onDelete: SetNull)
  vaccinationId String?
  vaccination Vaccination? @relation("auditVaccinations", fields: [vaccinationId], references: [id], onDelete: SetNull)
  parasiteTreatmentId String?
  parasiteTreatment ParasiteTreatment? @relation("auditParasiteTreatments", fields: [parasiteTreatmentId], references: [id], onDelete: SetNull)
  noteId String?
  note CatNote? @relation("auditNotes", fields: [noteId], references: [id], onDelete: SetNull)
  actorUserId String
  actorUser User @relation("auditActors", fields: [actorUserId], references: [id], onDelete: Restrict)
  relatedUserId String?
  relatedUser User? @relation("auditRelatedUsers", fields: [relatedUserId], references: [id], onDelete: SetNull)
  isTest Boolean @default(false)
  eventType String?
  action String?
  oldValue String?
  newValue String?
  occurredAt DateTime @default(now())
  createdAt DateTime @default(now())
  treatmentAdministrationDate DateTime? @db.Date
  @@index([catId, occurredAt])
  @@index([flightId, createdAt])
  @@index([locationId])
  @@index([tagId])
  @@index([actorUserId])
  @@index([createdAt])
  @@index([eventType])
  @@index([isTest])
  @@index([weightId])
  @@index([taskId])
  @@index([medicalNoteId])
  @@index([vaccinationId])
  @@index([parasiteTreatmentId])
  @@index([noteId])
}
model CatMedicalNote {
  id               String   @id @default(cuid())
  catId            String
  cat              Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  date             DateTime @db.Date
  comment          String
  createdByUserId String?
  createdByUser   User?    @relation("createdMedicalNotes", fields: [createdByUserId], references: [id], onDelete: SetNull)
  deletedAt        DateTime?
  concurrencyToken String   @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  auditEvents      AuditEvent[] @relation("auditMedicalNotes")

  @@index([catId, date])
  @@index([createdByUserId])
  @@unique([catId, createdByUserId, date])
  @@index([deletedAt])
}

model Vaccination {
  id               String   @id @default(cuid())
  catId            String
  cat              Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  createdByUserId  String?
  createdByUser    User?    @relation("createdVaccinations", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId  String?
  updatedByUser    User?    @relation("updatedVaccinations", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  type             VaccinationType
  date             DateTime @db.Date
  nextDueDate      DateTime? @db.Date
  vaccineName      String?
  deletedAt        DateTime?
  concurrencyToken String   @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  auditEvents      AuditEvent[] @relation("auditVaccinations")

  @@index([catId, date])
  @@index([deletedAt])
  @@index([createdByUserId])
  @@index([updatedByUserId])
}

model ParasiteTreatment {
  id               String   @id @default(cuid())
  catId            String
  cat              Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  createdByUserId  String?
  createdByUser    User?    @relation("createdParasiteTreatments", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId  String?
  updatedByUser    User?    @relation("updatedParasiteTreatments", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  type             ParasiteTreatmentType
  date             DateTime @db.Date
  nextDueDate      DateTime? @db.Date
  productName      String
  deletedAt        DateTime?
  concurrencyToken String   @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  auditEvents      AuditEvent[] @relation("auditParasiteTreatments")

  @@index([catId, date])
  @@index([deletedAt])
  @@index([createdByUserId])
  @@index([updatedByUserId])
}

model CatNote {
  id               String   @id @default(cuid())
  catId            String
  cat              Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  date             DateTime @db.Date
  comment          String
  createdByUserId String?
  createdByUser   User?    @relation("createdNotes", fields: [createdByUserId], references: [id], onDelete: SetNull)
  deletedAt        DateTime?
  concurrencyToken String   @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  auditEvents      AuditEvent[] @relation("auditNotes")

  @@index([catId, date])
  @@index([createdByUserId])
  @@unique([catId, createdByUserId, date])
  @@index([deletedAt])
}

model CatTask {
  id                String            @id @default(cuid())
  catId             String
  cat               Cat               @relation(fields: [catId], references: [id], onDelete: Cascade)
  comment           String
  dueDate           DateTime
  deletedAt         DateTime?
  concurrencyToken  String            @default(cuid())
  notificationSentAt DateTime?
  completedAt       DateTime?
  completedByUserId String?
  completedByUser   User?             @relation("completedTasks", fields: [completedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  receivers         CatTaskReceiver[]
  notifications     TaskNotification[]
  auditEvents       AuditEvent[] @relation("auditTasks")

  @@index([catId, dueDate])
  @@index([deletedAt, completedAt, dueDate])
  @@index([completedByUserId])
  @@index([deletedAt])
  @@index([notificationSentAt])
}

model CatTaskReceiver {
  taskId    String
  userId    String
  task      CatTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User      @relation("taskReceivers", fields: [userId], references: [id], onDelete: Restrict)
  deletedAt DateTime?
  version   Int       @default(0)

  @@id([taskId, userId])
  @@index([userId])
  @@index([deletedAt])
}

model TaskNotification {
  id        String    @id @default(cuid())
  taskId    String?
  treatmentId String?
  userId    String
  task      CatTask?  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  treatment CatTreatment? @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deletedAt DateTime?
  version   Int       @default(0)
  createdAt DateTime  @default(now())

  @@unique([taskId, userId])
  @@unique([treatmentId, userId])
  @@index([userId, createdAt])
  @@index([deletedAt])
}

