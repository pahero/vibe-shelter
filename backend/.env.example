# Environment
NODE_ENV=development

# Server
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/shelter

# S3
AWS_ENDPOINT_URL_S3=http://localhost:3900
S3_BUCKET=shelter
AWS_ACCESS_KEY_ID=your-s3-api-key
AWS_SECRET_ACCESS_KEY=your-s3-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Session
SESSION_COOKIE_NAME=shelter_session
SESSION_SECRET=your-secret-key-change-in-production
SESSION_TTL_HOURS=168

# Frontend
FRONTEND_URL=http://localhost:3001

# Optional
ALLOWED_GOOGLE_DOMAIN=example.com

# Seed
SEED_ADMIN_PASSWORD=admin12345
