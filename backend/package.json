{
  "name": "shelter-backend",
  "version": "0.0.1",
  "private": true,
  "description": "Shelter app authentication backend",
  "license": "UNLICENSED",
  "author": "Team",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "nest build",
    "upload:sourcemaps": "sentry-cli sourcemaps inject dist && sentry-cli sourcemaps upload dist",
    "format": "oxfmt --write src test prisma",
    "format:check": "oxfmt --check src test prisma",
    "lint": "oxlint -D correctness -A no-unused-vars -A no-useless-escape src test prisma",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "test": "tsc --noEmit && vitest run",
    "test:cov": "vitest run --coverage",
    "knip": "knip"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/schedule": "^12.0.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nestjs": "^11.11.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.3.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@sentry/cli": "^3.8.2",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "knip": "^6.44.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "js-yaml": "5.2.2"
  }
}
