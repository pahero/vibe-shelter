# Both DNS records must point to the VM's public IP.
APP_DOMAIN=shelter.example.com
STORAGE_DOMAIN=storage.shelter.example.com

# Keep these public ports for automatic TLS unless an external firewall or
# load balancer forwards 80/443 to different host ports.
HTTP_PORT=80
HTTPS_PORT=443

# Use URL-safe values here because Compose builds DATABASE_URL from them.
POSTGRES_USER=shelter
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
POSTGRES_DB=shelter

SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_TTL_HOURS=168
SEED_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password

# Garage access keys must use the formats accepted by Garage.
GARAGE_RPC_SECRET=replace-with-64-lowercase-hex-characters
GARAGE_ACCESS_KEY=GKreplacewith32hexcharacters
GARAGE_SECRET_KEY=replace-with-64-lowercase-hex-characters
GARAGE_BUCKET=shelter

# Google OAuth configuration expected by the backend.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=https://shelter.example.com/auth/google/callback
ALLOWED_GOOGLE_DOMAIN=
