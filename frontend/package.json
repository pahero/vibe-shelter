{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4001",
    "build": "next build",
    "start": "next start -p 4001",
    "lint": "oxlint --react-plugin --nextjs-plugin --jsx-a11y-plugin -D correctness -A no-unused-vars -A react/purity -A react/set-state-in-effect -A react/immutability -A jsx-a11y/control-has-associated-label -A jsx-a11y/prefer-tag-over-role -A jsx-a11y/no-noninteractive-element-to-interactive-role -A jsx-a11y/media-has-caption -A no-img-element .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "tsc --noEmit",
    "test:components": "vitest run"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@sentry/nextjs": "^11.11.0",
    "next": "16.4.4",
    "plotly.js": "^4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-plotly.js": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-plotly.js": "^2.6.4",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^7",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26"
  }
}
